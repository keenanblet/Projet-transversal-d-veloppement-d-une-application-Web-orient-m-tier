# Modèle du fichier .env : copier ce fichier en ".env" et remplir les valeurs.
# Le vrai .env n'est jamais publié sur GitHub (il est dans le .gitignore).

# Clé secrète qui signe les JWT. Générer avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Durée de validité d'une connexion, en minutes
JWT_EXPIRE_MINUTES=60
# true uniquement en production (HTTPS)
COOKIE_SECURE=false

# Connexion MySQL : mysql://utilisateur:motdepasse@ip:port/nom_de_la_base
DB_URL=
